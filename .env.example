# ============================================================
# 环境变量模板：复制本文件为 .env 后填写真实值
#   cp .env.example .env      (Linux / macOS)
#   copy .env.example .env    (Windows)
# ============================================================

# [必填] 通义千问 DashScope API Key（模型调用、向量化、视觉识别、API 重排均依赖）
DASHSCOPE_API_KEY=

# [可选] Redis 连接串。留空则使用本地内存缓存（多 worker 场景下不跨进程共享）。
#   docker-compose 部署时由 compose 注入：redis://redis:6379/0
REDIS_URL=

# [可选] 运行环境：development（热重载）/ production（关闭热重载）
APP_ENV=development

# [可选] CORS 白名单，逗号分隔多个来源；默认 * 允许所有
ALLOW_CORS_ORIGINS=*

# ------------------------------------------------------------
# 预留变量（当前版本代码中未使用，勿依赖）：
#   USE_RERANKER / USE_QUERY_REWRITE
#   重排与查询改写当前在 api_llm_pro_latest.py 启动阶段固定启用
#   （reranker 走在线 API，精排 Top-3），无环境变量开关。
# ------------------------------------------------------------
